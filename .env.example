# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (admin account, used only for setup and loading data)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketplace
POSTGRES_PORT=5432

# Read-only account used by the agent
AGENT_DB_USER=agent_readonly
AGENT_DB_PASSWORD=change-me-too

# LLM
GEMINI_API_KEY=
